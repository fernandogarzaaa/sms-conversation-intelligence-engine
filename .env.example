# Copy to .env and adjust. Every variable is optional; the defaults run a fully
# offline local demo (mock model, log-only SMS transport, no auth).

# --- storage ---------------------------------------------------------------
SMS_ENGINE_DB=sms_engine.db

# --- auth (set both in any shared environment) -----------------------------
# Comma-separated API keys for the JSON API (X-API-Key or Authorization: Bearer).
SMS_ENGINE_API_KEYS=
# HTTP Basic password for the review dashboard (any API key also works).
SMS_ENGINE_UI_USER=reviewer
SMS_ENGINE_UI_PASSWORD=

# --- model provider ----------------------------------------------------------
# mock | openai | openrouter | local | anthropic
SMS_ENGINE_PROVIDER=mock
SMS_ENGINE_MODEL=
SMS_ENGINE_BASE_URL=
SMS_ENGINE_API_KEY=
SMS_ENGINE_LLM_TIMEOUT=20

# --- SMS transport -----------------------------------------------------------
# log = record only, nothing leaves the machine | twilio = real delivery
SMS_ENGINE_TRANSPORT=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURES=true
# Public URL Twilio calls (needed to verify signatures behind a proxy/tunnel)
SMS_ENGINE_PUBLIC_URL=

# --- behaviour ------------------------------------------------------------------
SMS_ENGINE_AUTOMATION_CONFIG=config/automation.toml
SMS_ENGINE_DEFAULT_TZ=America/Chicago
# Seconds between in-process worker passes (0 = run `sms-engine worker` separately)
SMS_ENGINE_WORKER_INTERVAL=15
SMS_ENGINE_SEED_CLIENTS=true

# --- logging -------------------------------------------------------------------
SMS_ENGINE_LOG_LEVEL=INFO
SMS_ENGINE_LOG_JSON=false
